; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also allowed to be edited directly.

config_version=5

[application]

config/name="Cat As Trophe"
config/description="An open-world destruction sandbox: a cat versus everything humans built."
config/version="0.1.0"
run/main_scene="res://game/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.055, 0.075, 0.11, 1)
boot_splash/show_image=false

[autoload]

Game="*res://game/core/game.gd"
DamageRouter="*res://game/core/damage_router.gd"
Timeline="*res://game/time/timeline.gd"
Audio="*res://game/audio/audio_manager.gd"
Progress="*res://game/flow/progress.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/trophe_export/plugin.cfg")

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="structure"
3d_physics/layer_3="debris"
3d_physics/layer_4="debris_small"
3d_physics/layer_5="player"
3d_physics/layer_6="npc"
3d_physics/layer_7="protected"
3d_physics/layer_8="props"
3d_physics/layer_9="projectile"
3d_physics/layer_10="trigger"
3d_physics/layer_11="rubble"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3
common/max_physics_steps_per_frame.web=1
common/physics_interpolation=true
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=262144
jolt_physics_3d/limits/max_contact_constraints=65536
jolt_physics_3d/limits/temporary_memory_buffer_size=128

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
lights_and_shadows/directional_shadow/size.web=2048
scaling_3d/scale.web=0.75
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)
